# ==========================================
# El Buey Madurado — Variables de entorno
# ==========================================
# Copia este archivo a .env.local (desarrollo)
# o .env.docker (Docker) y completa los valores.

# ----- App Config -----
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=El Buey Madurado
NODE_ENV=development

# ----- MongoDB -----
# Docker local (NO uses srv:// para Docker)
MONGODB_URI=mongodb://root:password@mongo:27017/el_buey_madurado?authSource=admin
# Producción / Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>

# ----- JWT -----
# Genera uno fuerte: openssl rand -hex 32
JWT_SECRET=cambia_por_secreto_fuerte_64_caracteres

# ----- Cloudinary (almacenamiento de imágenes) -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# ----- Stripe (pagos online) -----
# Obtén las keys en https://dashboard.stripe.com/apikeys
# Formato: sk_test_... / pk_test_... (pruebas) o sk_live_... / pk_live_... (producción)
STRIPE_SECRET_KEY=TU_STRIPE_SECRET_KEY_AQUI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=TU_STRIPE_PUBLISHABLE_KEY_AQUI
