# El Buey Madurado - Docker Deployment

# App Config
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=El Buey Madurado
NODE_ENV=production

# Cloudinary (tu config real)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dzktzrrmp

# MongoDB Docker (NO uses srv:// para Docker local)
MONGODB_URI=mongodb://root:password@mongo:27017/el_buey_madurado?authSource=admin

# JWT (genera uno fuerte: openssl rand -hex 32)
JWT_SECRET=cambia_por_secreto_fuerte_64_caracteres

# NextAuth (genera: openssl rand -base64 32)
NEXTAUTH_SECRET=cambia_por_secreto_nextauth
NEXTAUTH_URL=http://localhost:3000
